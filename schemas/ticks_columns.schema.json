{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trace/ticks_columns.schema.json",
  "title": "Per-tick CSV column descriptor (ticks_columns.json)",
  "description": "Describes the column order, types, and units of ticks_<block>.csv (the 20 Hz per-tick log). trace-rt writes the CSV header from this file; the trace-kit integrity checker validates logged files against it. The canonical descriptor lives in configs/ticks_columns.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "columns"],
  "properties": {
    "schema_version": { "const": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "CSV header name."
          },
          "type": { "type": "string", "enum": ["float", "int", "bool"] },
          "unit": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
