# Allowlist: ignore everything in this Steam-managed tree, then un-ignore
# only this project's own folders. Keeps stock AC apps and the rest of the
# game out of git.
/*
!/.gitignore

!/thesis_framing_v5.md
!/implementation_plan_v1.md
!/evaluation_plan_v1.md
!/.github/
!/schemas/
!/configs/
!/kit/
!/lua/
/lua/*
!/lua/projspike_lua/
!/lua/trace_rt/
!/python/
/python/*
!/python/GRApp/

# Noise inside tracked folders
__pycache__/
*.pyc
