# Allowlist: ignore everything in this Steam-managed tree, then un-ignore
# only this project's own folders. Keeps stock AC apps and the rest of the
# game out of git.
/*
!/.gitignore

!/CLAUDE.md
!/thesis_framing_v6.md
!/implementation_plan_v2.md
!/evaluation_plan_v2.md
!/DATASET_README.md
!/.github/
!/schemas/
!/configs/
# The controller parity corpus: the only state the runtime and the simulator
# share besides controller_config.json (impl plan section 3), and the artefact
# Gate G1 rests on.
!/golden_traces/
!/kit/
!/lua/
/lua/*
!/lua/projspike_lua/
!/lua/trace_rt/
!/python/
/python/*
!/python/GRApp/

# Noise inside tracked folders
__pycache__/
*.pyc
.pytest_cache/
